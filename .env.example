# Copy to .env and edit before sourcing from the repository root.
export BREEZE_MODEL_ROOT=/path/to/Breeze-TTS-2
export BREEZE_TRAIN_MANIFEST="${PWD}/datasets/custom/train.jsonl"
export BREEZE_VALIDATION_MANIFEST="${PWD}/datasets/custom/validation.jsonl"
export BREEZE_CACHE_ROOT="${PWD}/cache/custom-v1"
export BREEZE_RUN_ROOT="${PWD}/runs/custom-lora-v1"
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export TOKENIZERS_PARALLELISM=false
# Optional: tools/gpu_session.sh stops/restores ONLY this named user service.
# export BREEZE_TTS_SERVICE=breeze-tts.service
